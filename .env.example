# API-nøkler (bare de leverandørene du bruker)
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Ollama (lokal modell)
OLLAMA_BASE_URL=http://127.0.0.1:11434/api

# ntfy-varsling (tom NTFY_TOPIC = ingen varsler)
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# Webserver
GANDRE_PORT=3040
GANDRE_BIND=0.0.0.0
# Adressen MOBILEN kan nå dashboardet på — brukes som klikk-lenke i ntfy-varsler.
# Anbefalt: Tailscale-navnet til serveren (virker overalt). Tom = ingen klikk-lenke.
GANDRE_PUBLIC_URL=

# Basic auth for web-UI (aktiveres når begge er satt — anbefalt!)
GANDRE_USER=
GANDRE_PASS=

# Diverse
GANDRE_DATA_DIR=./data
GANDRE_TZ=Europe/Oslo
GANDRE_RUN_TIMEOUT_MIN=30
